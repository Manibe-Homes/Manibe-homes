          </div>
          <div class="form-group">
            <label class="form-label" for="lead-contacto">Email o WhatsApp *</label>
            <input class="form-input" id="lead-contacto" name="contacto" type="text" placeholder="correo@ejemplo.com o +57 300 000 0000" required />
          </div>
