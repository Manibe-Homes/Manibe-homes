            <button type="button" class="btn-outline" style="flex:1;" onclick="document.getElementById('lead-modal').classList.remove('open')">Cancelar</button>
            <button type="submit" class="btn-primary-sm" id="lead-submit-btn" style="flex:2;">Enviar solicitud</button>
          </div>
          <p style="font-size:0.72rem;color:var(--navy-6);text-align:center;margin-top:0.75rem;line-height:1.5;">
            Al enviar confirmas que Manibe LLC podrá contactarte. No compartimos tu información con terceros.
          </p>
