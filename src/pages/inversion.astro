  <script define:vars={{ defaultModels, mapMarkers }}>
  // ─────────────────────────────────
  // CALCULATOR
  // ─────────────────────────────────
  var rawAmount = 100000;
  var activeProduct = 1;
  var activePlazo = 6;

  function fmt(n) { return '$' + Math.round(n).toLocaleString('en-US'); }
  function fmtPct(n) { return (n % 1 === 0 ? n : n.toFixed(1)) + '%'; }

  function updateSliderTrack() {
    var min = 50000, max = 500000;
    var pct = ((rawAmount - min) / (max - min)) * 100;
    document.getElementById('v-slider').style.setProperty('--pct', pct.toFixed(2) + '%');
  }

  function animateValue(el, newText) {
    el.style.opacity = '0'; el.style.transform = 'translateY(6px)';
    setTimeout(function() {
      el.textContent = newText;
      el.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
      el.style.opacity = '1'; el.style.transform = 'translateY(0)';
    }, 120);
  }

  function calculate() {
    var capital = rawAmount, months = activePlazo;
    var minROI, maxROI, minProfit, maxProfit, roiLabel;

    if (activeProduct === 1) {
      minROI = 0.12; maxROI = 0.20;
      minProfit = capital * minROI; maxProfit = capital * maxROI;
      var roiMinAnual = (minROI / months) * 12 * 100;
      var roiMaxAnual = (maxROI / months) * 12 * 100;
      roiLabel = fmtPct(Math.round(roiMinAnual)) + ' – ' + fmtPct(Math.round(roiMaxAnual));
      document.getElementById('v-roi-sub').textContent = 'anualizado (' + months + ' meses)';
    } else {
      var periodRate = 0.14 * (months / 12);
      minProfit = capital * periodRate; maxProfit = minProfit;
      roiLabel = '14%';
      document.getElementById('v-roi-sub').textContent = 'anual fijo';
    }

    var retMin = capital + minProfit, retMax = capital + maxProfit;
    var pctMin = ((minProfit / capital) * 100).toFixed(1);
    var pctMax = ((maxProfit / capital) * 100).toFixed(1);

    animateValue(document.getElementById('v-capital'), fmt(capital));
    animateValue(document.getElementById('v-ret-min'), fmt(retMin));
    animateValue(document.getElementById('v-ret-max'), fmt(retMax));
    animateValue(document.getElementById('v-roi-anual'), roiLabel);
    document.getElementById('v-ret-min-sub').textContent = '+' + pctMin + '% total';
    document.getElementById('v-ret-max-sub').textContent = '+' + (activeProduct === 2 ? pctMin : pctMax) + '% total';

    window._calcState = {
      capital: capital, retMin: retMin, retMax: retMax,
      product: activeProduct === 1 ? 'Colectiva Premium' : 'Rentabilidad Fija',
      plazo: months, roiLabel: roiLabel,
      minProfit: minProfit, maxProfit: maxProfit,
    };
  }

  document.getElementById('v-amount').addEventListener('input', function() {
    var digits = this.value.replace(/\D/g, '');
    rawAmount = Math.min(Math.max(parseInt(digits) || 0, 0), 500000);
    this.value = rawAmount.toLocaleString('en-US');
    document.getElementById('v-slider').value = String(rawAmount);
    updateSliderTrack(); calculate();
  });
  document.getElementById('v-slider').addEventListener('input', function() {
    rawAmount = parseInt(this.value);
    document.getElementById('v-amount').value = rawAmount.toLocaleString('en-US');
    updateSliderTrack(); calculate();
  });
  function toggleFijaNoteVisibility() {
    var note = document.getElementById('calc-fija-note');
    if (note) note.style.display = activeProduct === 2 ? 'block' : 'none';
  }

  document.querySelectorAll('.product-tab').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activeProduct = parseInt(this.dataset.product);
      document.querySelectorAll('.product-tab').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      if (activeProduct === 2) {
        activePlazo = 12;
        document.querySelectorAll('.plazo-tab').forEach(function(b) { b.classList.remove('active'); });
        document.querySelector('.plazo-tab[data-months="12"]').classList.add('active');
      }
      toggleFijaNoteVisibility();
      calculate();
    });
  });
  document.querySelectorAll('.plazo-tab').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activePlazo = parseInt(this.dataset.months);
      document.querySelectorAll('.plazo-tab').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      calculate();
    });
  });

  // Summary modal
  document.getElementById('v-gen-summary').addEventListener('click', function() {
    var s = window._calcState; if (!s) return;
    var now = new Date();
    document.getElementById('sum-date').textContent = now.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
    var rows = [
      { label: 'Capital invertido',  value: fmt(s.capital),    gold: false },
      { label: 'Producto',           value: s.product,         gold: false },
      { label: 'Plazo',              value: s.plazo + ' meses', gold: false },
      { label: 'ROI aplicado',       value: s.roiLabel,        gold: false },
      { label: 'Ganancia mínima',    value: fmt(s.minProfit),  gold: true  },
      { label: 'Ganancia máxima',    value: fmt(s.maxProfit),  gold: true  },
      { label: 'Retorno total mín.', value: fmt(s.retMin),     gold: true  },
      { label: 'Retorno total máx.', value: fmt(s.retMax),     gold: true  },
    ];
    document.getElementById('sum-rows').innerHTML = rows.map(function(r) {
      return '<div class="summary-row"><span class="summary-row-label">' + r.label + '</span><span class="summary-row-value' + (r.gold ? ' gold' : '') + '">' + r.value + '</span></div>';
    }).join('');
    document.getElementById('summary-modal').classList.add('open');
  });

  document.getElementById('sum-invest-btn').addEventListener('click', function() {
    var s = window._calcState;
    document.getElementById('summary-modal').classList.remove('open');
    openLeadModal(s ? s.product : '', s ? s.capital : null, s ? s.plazo : null);
  });

  // ─────────────────────────────────
  // LEAD MODAL
  // ─────────────────────────────────
  var _leadCtx = { interes: '', monto: null, plazo: null };

  function openLeadModal(interes, monto, plazo) {
    _leadCtx = { interes: interes || '', monto: monto || null, plazo: plazo || null };

    // Reset form & states
    document.getElementById('lead-form').reset();
    document.getElementById('lead-success').style.display = 'none';
    document.getElementById('lead-form-content').style.display = 'block';
    document.getElementById('lead-error-msg').style.display = 'none';
    document.getElementById('lead-error-msg').textContent = '';
    var btn = document.getElementById('lead-submit-btn');
    btn.disabled = false; btn.textContent = 'Enviar solicitud';

    // Pre-select interest
    if (interes) {
      var sel = document.getElementById('lead-interes');
      if (sel) sel.value = interes;
    }

    // Context info block
    var ctxEl = document.getElementById('lead-ctx-info');
    if (monto) {
      ctxEl.style.display = 'block';
      ctxEl.innerHTML = 'Simulación: <span>' + fmt(monto) + '</span> · <span>' + (plazo || '') + ' meses</span>' + (interes ? ' · <span>' + interes + '</span>' : '');
    } else {
      ctxEl.style.display = 'none';
    }

    document.getElementById('lead-modal').classList.add('open');
  }

  function fmt(n) { return '$' + Math.round(n).toLocaleString('en-US'); }

  document.getElementById('lead-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var nombre   = document.getElementById('lead-nombre').value.trim();
    var contacto = document.getElementById('lead-contacto').value.trim();
    var interes  = document.getElementById('lead-interes').value;
    var mensaje  = document.getElementById('lead-mensaje').value.trim();
    var errEl    = document.getElementById('lead-error-msg');
    var btn      = document.getElementById('lead-submit-btn');

    if (!nombre || !contacto) {
      errEl.textContent = 'Por favor completa nombre y contacto.';
      errEl.style.display = 'block'; return;
    }

    btn.disabled = true; btn.textContent = 'Enviando…';
    errEl.style.display = 'none';

    try {
      var res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre, contacto, interes: interes || undefined,
          monto_simulado: _leadCtx.monto,
          plazo_simulado: _leadCtx.plazo,
          mensaje: mensaje || undefined,
        }),
      });
      var data = await res.json();
      if (res.ok && data.ok) {
        document.getElementById('lead-form-content').style.display = 'none';
        document.getElementById('lead-success').style.display = 'block';
      } else {
        errEl.textContent = data.error || 'Error al enviar. Intenta de nuevo.';
        errEl.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Enviar solicitud';
      }
    } catch {
      errEl.textContent = 'Error de conexión. Intenta de nuevo.';
      errEl.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Enviar solicitud';
    }
  });

  // Close modal on overlay click
  document.getElementById('lead-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('open');
  });
  document.getElementById('summary-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('open');
  });

  // ─────────────────────────────────
  // MODEL VIEWER
  // ─────────────────────────────────
  var mdlCurrentIdx = {};

  function mdlGoTo(panelIdx, photoIdx) {
    var panel = document.querySelector('[data-model-panel="' + panelIdx + '"]');
    if (!panel) return;
    var thumbs = panel.querySelectorAll('.mdl-thumb');
    var mainImg = panel.querySelector('.model-main-img');
    var counter = panel.querySelector('.mdl-counter');
    var total = thumbs.length;
    if (!total) return;

    photoIdx = ((photoIdx % total) + total) % total;
    mdlCurrentIdx[panelIdx] = photoIdx;

    mainImg.style.opacity = '0';
    var newSrc = thumbs[photoIdx].src;
    setTimeout(function() {
      mainImg.src = newSrc;
      mainImg.style.opacity = '1';
    }, 180);

    thumbs.forEach(function(th, i) { th.classList.toggle('active', i === photoIdx); });
    thumbs[photoIdx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    if (counter) counter.textContent = (photoIdx + 1) + ' / ' + total;
  }

  defaultModels.forEach(function(m, i) {
    mdlCurrentIdx[i] = 0;
    var panel = document.querySelector('[data-model-panel="' + i + '"]');
    if (!panel) return;

    panel.querySelector('.mdl-prev').addEventListener('click', function() {
      mdlGoTo(i, (mdlCurrentIdx[i] || 0) - 1);
    });
    panel.querySelector('.mdl-next').addEventListener('click', function() {
      mdlGoTo(i, (mdlCurrentIdx[i] || 0) + 1);
    });

    panel.querySelectorAll('.mdl-thumb').forEach(function(th, j) {
      th.addEventListener('click', function() { mdlGoTo(i, j); });
    });
  });

  document.querySelectorAll('.model-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var idx = parseInt(this.dataset.modelIdx);
      document.querySelectorAll('.model-tab').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      document.querySelectorAll('.model-detail').forEach(function(p) { p.classList.remove('active'); });
      var panel = document.querySelector('[data-model-panel="' + idx + '"]');
      if (panel) panel.classList.add('active');
    });
  });

  // ─────────────────────────────────
  // MAP
  // ─────────────────────────────────
  function loadLeaflet(cb) {
    if (window.L) { cb(); return; }
    var css = document.createElement('link'); css.rel = 'stylesheet';
    css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(css);
    var js = document.createElement('script'); js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    js.onload = cb; document.head.appendChild(js);
  }

  function goldPin() {
    return window.L.divIcon({
      className: '', iconSize: [28, 36], iconAnchor: [14, 36], popupAnchor: [0, -38],
      html: '<svg viewBox="0 0 28 36" xmlns="http://www.w3.org/2000/svg" style="width:28px;height:36px;filter:drop-shadow(0 2px 6px rgba(0,0,0,0.6))"><path d="M14 0C6.268 0 0 6.268 0 14c0 7.732 14 22 14 22S28 21.732 28 14C28 6.268 21.732 0 14 0z" fill="#dbc06a"/><circle cx="14" cy="14" r="5" fill="#141d34"/></svg>',
    });
  }

  function initMap() {
    var L = window.L;
    var map = L.map('v-map', { center: [26.55, -81.85], zoom: 9, scrollWheelZoom: false });
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://carto.com/">CARTO</a>', subdomains: 'abcd', maxZoom: 19,
    }).addTo(map);
    var refs = mapMarkers.map(function(m) {
      return L.marker([m.lat, m.lng], { icon: goldPin() })
        .bindPopup('<p style="margin:0 0 2px;font-family:\'DM Sans\',sans-serif;font-size:13px;font-weight:700;color:#dbc06a;">' + m.label + '</p><p style="margin:0;font-family:\'DM Sans\',sans-serif;font-size:11px;color:#b8c0d4;">' + m.detail + '</p>', { maxWidth: 160 })
        .addTo(map);
    });
    setTimeout(function() {
      var bounds = L.latLngBounds(mapMarkers.map(function(m) { return [m.lat, m.lng]; }));
      map.fitBounds(bounds, { padding: [20, 20], maxZoom: 10 });
    }, 200);
    document.querySelectorAll('#v-map-tbody tr').forEach(function(row, i) {
      row.style.cursor = 'pointer';
      row.addEventListener('click', function() {
        var m = mapMarkers[i];
        map.setView([m.lat, m.lng], 12, { animate: false });
        refs[i].openPopup(); map.panBy([0, -70], { animate: true, duration: 0.4 });
      });
    });
  }

  var mapEl = document.getElementById('v-map');
  var obs = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting) { loadLeaflet(initMap); obs.disconnect(); }
  }, { threshold: 0.1 });
  if (mapEl) obs.observe(mapEl);

  // ─────────────────────────────────
  // INIT
  // ─────────────────────────────────
  updateSliderTrack();
  calculate();
  </script>

  <style>
    #v-map :global(.leaflet-control-zoom a) { background: #141d34; color: #dbc06a; border-color: #2c3a5c; }
    #v-map :global(.leaflet-control-zoom a:hover) { background: #2c3a5c; }
    #v-map :global(.leaflet-control-attribution) { background: rgba(12,21,36,0.8); color: #5e6d8c; font-size: 10px; }
    #v-map :global(.leaflet-popup-content-wrapper) { background: #141d34; border: 1px solid rgba(219,192,106,0.3); border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.6); padding: 0; }
    #v-map :global(.leaflet-popup-content) { margin: 0; padding: 10px 14px; }
    #v-map :global(.leaflet-popup-tip) { background: #141d34; }
    #v-map :global(.leaflet-popup-close-button) { color: #5e6d8c !important; }
  </style>

</body>
</html>
