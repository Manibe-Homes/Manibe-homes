<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invest in Florida with Manibe — ROI 12–20% in residential construction</title>
  <meta name="description" content="Residential construction projects in Southwest Florida. Capital with real backing, total transparency and proven returns. Family company with +15 years of experience." />
  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://manibehomes.com/en/inversion" />
  <meta property="og:title"       content="Invest in Florida with Manibe — ROI 12–20%" />
  <meta property="og:description" content="Family residential construction company in Southwest Florida. +15 years of experience, selected projects, total transparency." />
  <meta property="og:image"       content="https://manibehomes.com/og-inversion.png" />
  <meta name="twitter:card"       content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:    #0c1524;
      --navy-2:  #141d34;
      --navy-3:  #1e2a45;
      --navy-4:  #2c3a5c;
      --navy-5:  #3d4f72;
      --navy-6:  #5e6d8c;
      --navy-7:  #8894b0;
      --gold:    #dbc06a;
      --gold-h:  #c4a95a;
      --surface: #f0f1f5;
      --white:   #ffffff;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--navy); color: var(--white); min-height: 100vh; }
    .font-heading { font-family: 'Playfair Display', serif; }

    /* ── HEADER ── */
    .v-header {
      background: var(--navy-2);
      border-bottom: 1px solid var(--navy-4);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      position: sticky; top: 0; z-index: 500;
    }
    .v-header-left {
      display: flex; flex-direction: column;
      align-items: flex-start; gap: 0.5rem;
    }
    .v-header img { height: 50px; width: auto; display: block; }
    @media (max-width: 768px) { .v-header img { height: 42px; } }
    .v-badge {
      font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--gold); background: rgba(219,192,106,0.1); border: 1px solid rgba(219,192,106,0.25);
      padding: 0.2rem 0.75rem; border-radius: 999px; width: fit-content;
    }
    .v-header-nav { display: flex; gap: 1.5rem; align-items: center; }
    .v-header-nav a {
      color: var(--navy-7); text-decoration: none; font-size: 0.85rem; font-weight: 500;
      transition: color 0.2s; white-space: nowrap;
    }
    .v-header-nav a:hover { color: var(--white); }
    .v-header-cta {
      background: var(--gold); color: var(--navy); font-weight: 700; font-size: 0.85rem;
      padding: 0.6rem 1.25rem; border-radius: 0.75rem; border: none; cursor: pointer;
      transition: background 0.2s; white-space: nowrap;
    }
    /* ── LANG SWITCHER ── */
    .v-lang { position: relative; }
    .v-lang-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.35rem 0.75rem; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.2); background: transparent;
      color: rgba(255,255,255,0.8); font-size: 0.8rem; font-weight: 600;
      cursor: pointer; transition: all 0.2s;
    }
    .v-lang-btn:hover { border-color: var(--gold); color: var(--gold); }
    .v-lang-flag { width: 20px; height: auto; border-radius: 2px; flex-shrink: 0; }
    .v-lang-chev { transition: transform 0.2s; }
    .v-lang-panel {
      display: none; position: absolute; right: 0; top: calc(100% + 0.5rem);
      width: 9.5rem; background: var(--navy-2); border: 1px solid var(--navy-4);
      border-radius: 0.75rem; overflow: hidden; z-index: 600;
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }
    .v-lang-panel.open { display: block; }
    .v-lang-opt {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.65rem 0.85rem; font-size: 0.85rem; font-weight: 500;
      color: rgba(255,255,255,0.75); text-decoration: none; transition: background 0.15s;
    }
    .v-lang-opt:hover { background: var(--navy-3); color: #fff; }
    .v-lang-active { color: var(--gold) !important; background: var(--navy-3); pointer-events: none; }
    .v-header-cta:hover { background: var(--gold-h); }
    @media (max-width: 768px) {
      .v-header-nav { display: none; }
    }

    /* ── SECTIONS ── */
    .v-section { padding: 5rem 2rem; }
    .v-section.light { background: var(--surface); color: var(--navy); }
    .v-section.dark  { background: var(--navy); }
    .v-section.mid   { background: var(--navy-2); }
    .v-inner { max-width: 1100px; margin: 0 auto; }
    .v-section-label {
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 0.5rem;
    }
    .v-section-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; line-height: 1.15;
      margin-bottom: 1rem;
    }
    .v-section-title.dark-text { color: var(--navy); }
    .v-section-sub { font-size: 1.05rem; color: var(--navy-7); max-width: 700px; line-height: 1.7; }

    /* ── HERO ── */
    .hero-section {
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden; padding: 6rem 2rem 4rem;
    }
    /* TODO: agregar imagen definitiva al recibir el asset /fondo-inversion.jpg */
    .hero-bg-img {
      position: absolute; inset: 0; width: 100%; height: 115%; top: -7.5%;
      object-fit: cover; z-index: 0; will-change: transform;
    }
    .hero-overlay {
      position: absolute; inset: 0; z-index: 1;
      background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 50%, rgba(0,0,0,0.6) 100%);
    }
    .hero-overlay-bottom {
      position: absolute; bottom: 0; left: 0; right: 0; height: 8rem; z-index: 1;
      background: linear-gradient(to top, #0c1524, transparent);
    }
    .hero-inner {
      max-width: 900px; margin: 0 auto; width: 100%; position: relative; z-index: 2;
      text-align: center; display: flex; flex-direction: column; align-items: center;
    }
    .hero-title {
      font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 700; color: #fff; line-height: 1.15; margin-bottom: 1.5rem;
      background: rgba(20, 29, 52, 0.5); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.75rem; padding: 1.25rem 1.75rem;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    }
    .hero-desc {
      font-size: 1.15rem; color: rgba(255,255,255,0.72); line-height: 1.8;
      max-width: 680px; margin-bottom: 3rem; text-align: center;
      background: rgba(20, 29, 52, 0.5); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.75rem; padding: 1.25rem 1.75rem;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    }
    .btn-gold {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      background: var(--gold); color: var(--navy); font-weight: 700; font-size: 1rem;
      padding: 1rem 2.25rem; border-radius: 1rem; border: none; cursor: pointer;
      transition: background 0.2s; text-decoration: none;
    }
    .btn-gold:hover { background: var(--gold-h); }
    .btn-ghost {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border: 2px solid rgba(219,192,106,0.4); color: var(--gold);
      padding: 1rem 2.25rem; border-radius: 1rem; text-decoration: none;
      font-weight: 600; font-size: 1rem; transition: all 0.2s;
    }
    .btn-ghost:hover { border-color: var(--gold); background: rgba(219,192,106,0.06); }
    .hero-stats {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
      max-width: 700px; width: 100%; margin-top: 1rem;
    }
    .hero-stats > div {
      background: rgba(20, 29, 52, 0.5);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.75rem;
      padding: 1.25rem 1rem;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .hero-stat-val {
      font-family: 'Playfair Display', serif;
      font-size: 2.25rem; font-weight: 700; color: var(--gold); line-height: 1;
      margin-bottom: 0.4rem;
    }
    .hero-stat-label { font-size: 0.82rem; color: rgba(255,255,255,0.55); line-height: 1.5; }
    @media (max-width: 540px) {
      .hero-stats { grid-template-columns: 1fr 1fr; }
      .hero-stats > div:last-child { grid-column: 1 / -1; }
    }

    /* ── TRAYECTORIA ── */
    .tray-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;
      margin-top: 3rem;
    }
    .tray-text p { font-size: 1.05rem; color: var(--navy-5); line-height: 1.8; margin-bottom: 1.25rem; text-align: justify; }
    .tray-stats-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
    }
    .tray-stat-card {
      background: var(--navy); border-radius: 1.25rem; padding: 1.75rem 1.5rem; text-align: center;
      border: 1px solid var(--navy-4);
    }
    .tray-stat-val {
      font-family: 'Playfair Display', serif;
      font-size: 2.25rem; font-weight: 700; color: var(--gold); margin-bottom: 0.35rem;
    }
    .tray-stat-label { font-size: 0.8rem; color: rgba(255,255,255,0.5); line-height: 1.45; }
    @media (max-width: 860px) {
      .tray-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    }

    /* ── PRODUCTOS ── */
    .prod-stack { display: flex; flex-direction: column; gap: 2rem; margin-top: 3rem; }

    .prod-block {
      background: var(--navy-2); border: 1px solid var(--navy-4);
      border-radius: 1.75rem; overflow: hidden; position: relative;
    }
    .prod-block.featured {
      border-color: rgba(219,192,106,0.45);
      background: linear-gradient(135deg, rgba(219,192,106,0.04) 0%, var(--navy-2) 50%);
    }

    .prod-rec-strip {
      background: var(--gold); color: var(--navy);
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 0.4rem 1.5rem; text-align: center;
    }

    .prod-block-inner {
      display: grid; grid-template-columns: 320px 1fr;
      gap: 0; align-items: stretch;
    }
    @media (max-width: 900px) { .prod-block-inner { grid-template-columns: 1fr; } }

    .prod-block-left {
      padding: 2.5rem 2rem; display: flex; flex-direction: column; gap: 1.25rem;
      border-right: 1px solid var(--navy-4);
    }
    @media (max-width: 900px) { .prod-block-left { border-right: none; border-bottom: 1px solid var(--navy-4); } }

    .prod-number {
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--gold); opacity: 0.7;
    }
    .prod-name {
      font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700;
      color: var(--white); line-height: 1.2;
    }
    .prod-tagline { font-size: 0.82rem; color: var(--gold); font-style: italic; margin-top: -0.5rem; }
    .prod-desc { font-size: 0.9rem; color: var(--navy-7); line-height: 1.7; }

    .prod-roi-wrap { padding: 1.25rem 1rem; background: rgba(219,192,106,0.06); border: 1px solid rgba(219,192,106,0.18); border-radius: 1rem; }
    .prod-roi {
      font-family: 'Playfair Display', serif; font-size: 2.75rem; font-weight: 700;
      color: var(--gold); line-height: 1;
    }
    .prod-roi-label { font-size: 0.75rem; color: var(--navy-7); margin-top: 0.3rem; line-height: 1.45; }
    .prod-plazo {
      display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.6rem;
      background: rgba(219,192,106,0.08); border: 1px solid rgba(219,192,106,0.2);
      color: var(--gold); font-size: 0.78rem; font-weight: 600;
      padding: 0.28rem 0.75rem; border-radius: 999px;
    }

    .btn-gold-full {
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      background: var(--gold); color: var(--navy); font-weight: 700; font-size: 0.95rem;
      padding: 0.85rem 1.5rem; border-radius: 0.875rem; border: none; cursor: pointer;
      transition: background 0.2s; width: 100%; margin-top: auto;
    }
    .btn-gold-full:hover { background: var(--gold-h); }
    .btn-outline-full {
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      background: transparent; color: var(--gold); border: 2px solid rgba(219,192,106,0.4);
      font-weight: 700; font-size: 0.95rem; padding: 0.85rem 1.5rem; border-radius: 0.875rem;
      cursor: pointer; transition: all 0.2s; width: 100%; margin-top: auto;
    }
    .btn-outline-full:hover { border-color: var(--gold); background: rgba(219,192,106,0.06); }
    .prod-disclaimer { font-size: 0.68rem; color: var(--navy-6); text-align: center; margin-top: 0.5rem; line-height: 1.5; }

    .prod-block-right { padding: 2.5rem 2rem; display: flex; flex-direction: column; gap: 2rem; }

    .prod-section-label {
      font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--navy-6); margin-bottom: 1rem;
    }

    /* Horizontal step flow */
    .prod-steps-h {
      display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      gap: 0; align-items: start;
    }
    @media (max-width: 640px) {
      .prod-steps-h { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .prod-step-arrow { display: none; }
    }
    .prod-step-h {
      background: rgba(44,58,92,0.4); border: 1px solid var(--navy-4);
      border-radius: 0.875rem; padding: 0.875rem 0.75rem;
      display: flex; flex-direction: column; gap: 0.5rem; height: 100%;
    }
    .prod-step-h-num {
      width: 22px; height: 22px; border-radius: 50%;
      background: rgba(219,192,106,0.15); border: 1px solid rgba(219,192,106,0.35);
