  <script define:vars={{ defaultModels }}>
  // ─────────────────────────────────
  // LANG SWITCHER
  // ─────────────────────────────────
  (function() {
    var btn = document.getElementById('v-lang-btn');
    var panel = document.getElementById('v-lang-panel');
    var chev = document.getElementById('v-lang-chev');
    if (!btn || !panel) return;
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var open = panel.classList.toggle('open');
      btn.setAttribute('aria-expanded', open);
      chev.style.transform = open ? 'rotate(180deg)' : '';
    });
    document.addEventListener('click', function() {
      panel.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      chev.style.transform = '';
    });
  })();

  // ─────────────────────────────────
  // HERO PARALLAX
  // ─────────────────────────────────
  (function() {
    var bg = document.getElementById('hero-inversion-bg');
    var hero = document.getElementById('hero');
    if (!bg || !hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var ticking = false;
    function update() {
      var scrollY = window.scrollY;
      if (scrollY <= hero.offsetHeight) bg.style.transform = 'translateY(' + (scrollY * 0.3) + 'px)';
      ticking = false;
    }
    window.addEventListener('scroll', function() {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    update();
  })();

  // ─────────────────────────────────
  // LEAD MODAL
  // ─────────────────────────────────
  var _leadCtx = { interes: '', monto: null, plazo: null };

  function openLeadModal(interes, monto, plazo) {
    _leadCtx = { interes: interes || '', monto: monto || null, plazo: plazo || null };

    // Reset form & states
    document.getElementById('lead-form').reset();
    document.getElementById('lead-success').style.display = 'none';
    document.getElementById('lead-form-content').style.display = 'block';
    document.getElementById('lead-error-msg').style.display = 'none';
    document.getElementById('lead-error-msg').textContent = '';
    var btn = document.getElementById('lead-submit-btn');
    btn.disabled = false; btn.textContent = 'Enviar solicitud';

    // Pre-select interest
    if (interes) {
      var sel = document.getElementById('lead-interes');
      if (sel) sel.value = interes;
    }

    // Context info block
    var ctxEl = document.getElementById('lead-ctx-info');
    if (monto) {
      ctxEl.style.display = 'block';
      ctxEl.innerHTML = 'Simulación: <span>' + fmt(monto) + '</span> · <span>' + (plazo || '') + ' meses</span>' + (interes ? ' · <span>' + interes + '</span>' : '');
    } else {
      ctxEl.style.display = 'none';
    }

    document.getElementById('lead-modal').classList.add('open');
  }
  window.openLeadModal = openLeadModal;

  function fmt(n) { return '$' + Math.round(n).toLocaleString('en-US'); }

  document.getElementById('lead-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var nombre   = document.getElementById('lead-nombre').value.trim();
    var contacto = document.getElementById('lead-contacto').value.trim();
    var interes  = document.getElementById('lead-interes').value;
    var mensaje  = document.getElementById('lead-mensaje').value.trim();
    var errEl    = document.getElementById('lead-error-msg');
    var btn      = document.getElementById('lead-submit-btn');

    if (!nombre || !contacto) {
      errEl.textContent = 'Por favor completa nombre y contacto.';
      errEl.style.display = 'block'; return;
    }

    btn.disabled = true; btn.textContent = 'Enviando…';
    errEl.style.display = 'none';

    try {
      var res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre, contacto, interes: interes || undefined,
          monto_simulado: _leadCtx.monto,
          plazo_simulado: _leadCtx.plazo,
          mensaje: mensaje || undefined,
        }),
      });
      var data = await res.json();
      if (res.ok && data.ok) {
        document.getElementById('lead-form-content').style.display = 'none';
        document.getElementById('lead-success').style.display = 'block';
      } else {
        errEl.textContent = data.error || 'Error al enviar. Intenta de nuevo.';
        errEl.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Enviar solicitud';
      }
    } catch {
      errEl.textContent = 'Error de conexión. Intenta de nuevo.';
      errEl.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Enviar solicitud';
    }
  });

  // Close modal on overlay click
  document.getElementById('lead-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('open');
  });

  // ─────────────────────────────────
  // MODEL VIEWER
  // ─────────────────────────────────
  var mdlCurrentIdx = {};

  function mdlGoTo(panelIdx, photoIdx) {
    var panel = document.querySelector('[data-model-panel="' + panelIdx + '"]');
    if (!panel) return;
    var thumbs = panel.querySelectorAll('.mdl-thumb');
    var mainImg = panel.querySelector('.model-main-img');
    var counter = panel.querySelector('.mdl-counter');
    var total = thumbs.length;
    if (!total) return;

    photoIdx = ((photoIdx % total) + total) % total;
    mdlCurrentIdx[panelIdx] = photoIdx;

    mainImg.style.opacity = '0';
    var newSrc = thumbs[photoIdx].src;
    setTimeout(function() {
      mainImg.src = newSrc;
      mainImg.style.opacity = '1';
    }, 180);

    thumbs.forEach(function(th, i) { th.classList.toggle('active', i === photoIdx); });
    thumbs[photoIdx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    if (counter) counter.textContent = (photoIdx + 1) + ' / ' + total;
  }

  defaultModels.forEach(function(m, i) {
    mdlCurrentIdx[i] = 0;
    var panel = document.querySelector('[data-model-panel="' + i + '"]');
    if (!panel) return;

    panel.querySelector('.mdl-prev').addEventListener('click', function() {
      mdlGoTo(i, (mdlCurrentIdx[i] || 0) - 1);
    });
    panel.querySelector('.mdl-next').addEventListener('click', function() {
      mdlGoTo(i, (mdlCurrentIdx[i] || 0) + 1);
    });

    panel.querySelectorAll('.mdl-thumb').forEach(function(th, j) {
      th.addEventListener('click', function() { mdlGoTo(i, j); });
    });
  });

  document.querySelectorAll('.model-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var idx = parseInt(this.dataset.modelIdx);
      document.querySelectorAll('.model-tab').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      document.querySelectorAll('.model-detail').forEach(function(p) { p.classList.remove('active'); });
      var panel = document.querySelector('[data-model-panel="' + idx + '"]');
      if (panel) panel.classList.add('active');
    });
  });

  </script>

</body>
</html>
