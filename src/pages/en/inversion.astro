      display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1.5rem;
    }
    @media (max-width: 640px) { .prod-benefits-grid { grid-template-columns: 1fr; } }
    .prod-benefit {
      display: flex; align-items: flex-start; gap: 0.55rem;
      font-size: 0.85rem; color: var(--navy-7); line-height: 1.45;
    }
    .prod-benefit-icon { color: var(--gold); flex-shrink: 0; font-size: 0.8rem; margin-top: 3px; }

    /* ── MODEL VIEWER ── */
    .stat-num { font-weight: 700; font-size: 1rem; color: var(--white); }
    .model-extra-tag {
      background: rgba(219,192,106,0.08); border: 1px solid rgba(219,192,106,0.2);
      color: rgba(219,192,106,0.8); font-size: 0.72rem; font-weight: 600;
      padding: 0.25rem 0.65rem; border-radius: 999px; white-space: nowrap;
    }

    .model-viewer { margin-top: 2.5rem; }

    .model-tabs { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .model-tab {
      position: relative; background: rgba(44,58,92,0.3); border: 2px solid var(--navy-4);
      color: var(--navy-7); font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 1rem;
      padding: 0.75rem 2rem; border-radius: 0.875rem; cursor: pointer; transition: all 0.2s; white-space: nowrap;
    }
    .model-tab:hover:not(.active) { border-color: var(--navy-5); color: var(--white); }
    .model-tab.active { border-color: var(--gold); background: rgba(219,192,106,0.1); color: var(--white); }
    .model-tab-badge {
      position: absolute; top: -9px; right: -6px;
      background: var(--gold); color: var(--navy);
      font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
      padding: 0.18rem 0.55rem; border-radius: 999px; white-space: nowrap;
    }

    .model-detail {
      display: none; background: var(--navy-2); border: 1px solid var(--navy-4);
      border-radius: 1.5rem; overflow: hidden;
    }
    .model-detail.active { display: grid; grid-template-columns: 55% 45%; }
    @media (max-width: 900px) { .model-detail.active { grid-template-columns: 1fr; } }

    .model-gallery-col { background: var(--navy-3); }
    .model-main-wrap { position: relative; overflow: hidden; }
    .model-main-img {
      width: 100%; height: 420px; object-fit: cover; display: block;
      transition: opacity 0.25s ease;
    }
    @media (max-width: 900px) { .model-main-img { height: 260px; } }

    .mdl-nav {
      position: absolute; top: 50%; transform: translateY(-50%);
      background: rgba(12,21,36,0.72); border: 1px solid rgba(219,192,106,0.25);
      color: var(--white); width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.2s; font-size: 1.25rem; z-index: 2;
      backdrop-filter: blur(4px); line-height: 1;
    }
    .mdl-nav:hover { background: rgba(219,192,106,0.25); border-color: var(--gold); }
    .mdl-prev { left: 12px; }
    .mdl-next { right: 12px; }
    .mdl-counter {
      position: absolute; bottom: 10px; right: 12px;
      background: rgba(12,21,36,0.72); backdrop-filter: blur(4px);
      color: rgba(255,255,255,0.7); font-size: 0.72rem; font-weight: 600;
      padding: 0.22rem 0.6rem; border-radius: 999px; pointer-events: none;
    }

    .model-thumbs {
      display: flex; gap: 0.4rem; overflow-x: auto; padding: 0.6rem;
      scrollbar-width: thin; scrollbar-color: var(--navy-4) transparent;
    }
    .model-thumbs::-webkit-scrollbar { height: 4px; }
    .model-thumbs::-webkit-scrollbar-thumb { background: var(--navy-4); border-radius: 2px; }
    .mdl-thumb {
      width: 68px; height: 50px; object-fit: cover; border-radius: 0.4rem; flex-shrink: 0;
      border: 2px solid transparent; cursor: pointer; transition: border-color 0.15s, opacity 0.15s; opacity: 0.5;
    }
    .mdl-thumb.active { border-color: var(--gold); opacity: 1; }
    .mdl-thumb:hover:not(.active) { opacity: 0.8; }

    .model-info-col {
      padding: 2rem 2.25rem; display: flex; flex-direction: column; gap: 1.25rem;
      border-left: 1px solid var(--navy-4); overflow-y: auto; max-height: 520px;
    }
    @media (max-width: 900px) { .model-info-col { border-left: none; border-top: 1px solid var(--navy-4); max-height: none; } }

    .model-info-name {
      font-family: 'Playfair Display', serif; font-size: 1.85rem; font-weight: 700;
      color: var(--white); line-height: 1.15; margin-top: 0.25rem;
    }
    .model-info-tag {
      display: inline-block; background: var(--gold); color: var(--navy);
      font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
      padding: 0.2rem 0.65rem; border-radius: 999px; margin-bottom: 0.2rem;
    }
    .model-info-stats { display: flex; gap: 2rem; }
    .model-info-stat { display: flex; align-items: baseline; gap: 0.4rem; font-size: 0.88rem; color: var(--navy-7); }
    .model-info-stat .stat-num { font-size: 1.6rem; font-family: 'Playfair Display', serif; }

    .model-specs-table {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1rem;
      background: rgba(44,58,92,0.35); border-radius: 0.875rem; padding: 1rem 1.1rem;
    }
    .model-spec-row { display: flex; flex-direction: column; gap: 0.15rem; }
    .model-spec-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--navy-6); }
    .model-spec-value { font-size: 0.88rem; color: var(--white); font-weight: 500; }

    .model-info-extras { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .model-info-desc { font-size: 0.9rem; color: var(--navy-7); line-height: 1.75; }

    .btn-model-cta {
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      background: var(--gold); color: var(--navy); font-weight: 700; font-size: 0.9rem;
      padding: 0.9rem 1.5rem; border-radius: 0.875rem; border: none; cursor: pointer;
      transition: background 0.2s; width: 100%; margin-top: auto;
    }
    .btn-model-cta:hover { background: var(--gold-h); }

    /* ── GARANTÍAS ── */
    .gar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 3rem; }
    @media (max-width: 860px) { .gar-grid { grid-template-columns: 1fr; } }
    .gar-card {
      background: var(--navy-2); border: 1px solid var(--navy-4); border-radius: 1.5rem;
      padding: 2rem; display: flex; flex-direction: column; gap: 1rem;
      transition: border-color 0.25s;
    }
    .gar-card:hover { border-color: rgba(219,192,106,0.3); }
    .gar-icon {
      width: 48px; height: 48px; border-radius: 1rem;
      background: rgba(219,192,106,0.1); border: 1px solid rgba(219,192,106,0.2);
      display: flex; align-items: center; justify-content: center; color: var(--gold);
    }
    .gar-title { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; color: var(--white); }
    .gar-items { display: flex; flex-direction: column; gap: 0.55rem; }
    .gar-item {
      display: flex; align-items: flex-start; gap: 0.6rem;
      font-size: 0.88rem; color: var(--navy-7); line-height: 1.45;
    }
    .gar-item-dot { flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--gold); margin-top: 6px; }

    /* ── CTA FINAL ── */
    .cta-final {
      background: var(--navy); padding: 6rem 2rem;
      border-top: 1px solid var(--navy-4);
    }
    .cta-final-inner { max-width: 680px; margin: 0 auto; text-align: center; }
    .cta-final-title {
      font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700; line-height: 1.15; margin-bottom: 1.25rem;
    }
    .cta-final-sub { font-size: 1.05rem; color: rgba(255,255,255,0.6); line-height: 1.7; margin-bottom: 2.5rem; }
    .cta-final-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-wa {
      display: inline-flex; align-items: center; gap: 0.6rem;
      background: #25d366; color: #fff; font-weight: 700; font-size: 0.95rem;
      padding: 0.9rem 1.75rem; border-radius: 1rem; text-decoration: none;
      transition: background 0.2s;
    }
    .btn-wa:hover { background: #1ebe5d; }

    /* ── FOOTER ── */
    .v-footer { background: var(--navy-2); border-top: 1px solid var(--navy-4); padding: 1.5rem 2rem; text-align: center; }
    .v-footer p { font-size: 0.8rem; color: var(--navy-7); }

    /* ── MODALS ── */
    .modal-overlay {
      display: none; position: fixed; inset: 0; z-index: 9000;
      background: rgba(12,21,36,0.88); backdrop-filter: blur(4px);
      align-items: center; justify-content: center; padding: 1.5rem;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: var(--navy-2); border: 1px solid var(--navy-4); border-radius: 1.5rem;
      padding: 2rem; width: 100%; max-width: 540px; max-height: 90vh; overflow-y: auto;
      box-shadow: 0 24px 80px rgba(0,0,0,0.6);
    }
    .modal-title { font-family: 'Playfair Display',serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--white); }
    .modal-footer { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--navy-7); margin-bottom: 0.5rem; }
    .form-input {
      width: 100%; background: rgba(44,58,92,0.5); border: 1.5px solid var(--navy-4);
      color: var(--white); border-radius: 0.75rem; padding: 0.75rem 1rem;
      font-size: 0.95rem; outline: none; transition: border-color 0.2s;
      font-family: 'DM Sans', sans-serif;
    }
    .form-input:focus { border-color: var(--gold); }
    .form-input::placeholder { color: var(--navy-6); }
    select.form-input option { background: var(--navy-2); color: var(--white); }
    .tag-input-wrap { display: flex; gap: 0.5rem; }
    .tag-input-wrap .form-input { flex: 1; }
    .btn-outline {
      background: transparent; border: 1.5px solid var(--navy-4); color: var(--navy-7);
      font-weight: 600; font-size: 0.85rem; padding: 0.6rem 1.25rem; border-radius: 0.75rem;
      cursor: pointer; transition: all 0.15s;
    }
    .btn-outline:hover { border-color: var(--navy-6); color: var(--white); }
    .btn-primary-sm {
      background: var(--gold); color: var(--navy); font-weight: 700; font-size: 0.85rem;
      padding: 0.6rem 1.5rem; border-radius: 0.75rem; border: none; cursor: pointer; transition: background 0.15s;
    }
    .btn-primary-sm:hover { background: var(--gold-h); }
    .tags-preview { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; min-height: 1.5rem; }
    .tag-chip {
      background: rgba(219,192,106,0.12); border: 1px solid rgba(219,192,106,0.3);
      color: var(--gold); font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem;
      border-radius: 999px; display: flex; align-items: center; gap: 0.3rem; cursor: pointer;
    }
    .tag-chip:hover { background: rgba(219,192,106,0.2); }

    /* ── LEAD MODAL ── */
    .lead-success {
      text-align: center; padding: 2rem 0; display: none;
    }
    .lead-success-icon {
      width: 64px; height: 64px; border-radius: 50%;
      background: rgba(219,192,106,0.12); border: 2px solid rgba(219,192,106,0.35);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.25rem; color: var(--gold); font-size: 1.75rem;
    }
    .lead-success h3 { font-family: 'Playfair Display',serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; }
    .lead-success p { font-size: 0.95rem; color: var(--navy-7); line-height: 1.6; }
    .lead-error-msg {
      display: none; background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.25);
      color: #f87171; border-radius: 0.75rem; padding: 0.75rem 1rem;
      font-size: 0.85rem; margin-bottom: 1rem;
    }
    .lead-ctx-info {
      background: rgba(219,192,106,0.06); border: 1px solid rgba(219,192,106,0.18);
      border-radius: 0.75rem; padding: 0.75rem 1rem; margin-bottom: 1.25rem;
      font-size: 0.82rem; color: var(--navy-7); display: none;
    }
    .lead-ctx-info span { color: var(--gold); font-weight: 600; }

  </style>
</head>
